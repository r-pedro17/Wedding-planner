# --- Convex --- (written by `pnpm exec convex dev`)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# --- Clerk --- (written by `pnpm dlx clerk@latest init --framework next -y`)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Eve (agent/) ---
# Model provider key for the eve runtime.
AI_GATEWAY_API_KEY=
# Convex URL Eve reads/writes through, and a Clerk JWT for the couple so
# Eve is a real member of the wedding rather than an anonymous caller.
CONVEX_URL=
CONVEX_AGENT_TOKEN=
# Where the eve channel is served, so the in-app Eve panel can reach it.
NEXT_PUBLIC_EVE_URL=

# --- Set on the Convex deployment, NOT here ---
# CLERK_JWT_ISSUER_DOMAIN — the Issuer URL of the Clerk instance, e.g.
# https://<slug>.clerk.accounts.dev. Convex refuses to push while it is unset:
#   pnpm exec convex env set CLERK_JWT_ISSUER_DOMAIN https://<slug>.clerk.accounts.dev
#
# Clerk also needs a JWT template named exactly "convex" whose claims include
# {"aud": "convex"} — without the aud claim Convex rejects the token with
# NoAuthProvider. Create it with:
#   pnpm dlx clerk@latest api //jwt_templates -X POST -d '{"name":"convex","claims":{"aud":"convex"},"lifetime":3600}' --yes
