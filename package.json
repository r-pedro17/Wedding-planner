  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components convex tests agent proxy.ts next.config.ts vitest.config.ts",
    "lint:ox": "oxlint . --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "fallow": "fallow --format json --quiet --explain",
    "fallow:ci": "fallow audit --gate new-only --format json --quiet --explain --fail-on-issues",
    "verify": "pnpm lint && pnpm lint:ox && pnpm typecheck && pnpm test && pnpm build",
    "convex": "convex dev"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.8.3",
