    "clsx": "^2.1.1",
    "convex": "^1.45.0",
    "eve": "^0.47.3",
    "next": "^16.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^2.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "convex-test": "^0.0.56",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.3",
